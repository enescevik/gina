{
  "name": "gina",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "mobile": "pnpm --filter @gina/mobile exec expo start",
    "db:start": "pnpm exec supabase start",
    "db:stop": "pnpm exec supabase stop",
    "db:reset": "pnpm exec supabase db reset",
    "db:test": "pnpm exec supabase test db",
    "db:types": "pnpm exec supabase gen types typescript --local --schema public > packages/core/src/database.types.ts"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "supabase": "^2.122.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
