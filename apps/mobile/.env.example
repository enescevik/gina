# Yerel Supabase: `pnpm db:start` çıktısındaki API URL ve anon key
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Veli webinin kökü (öğretmen paylaşım bağlantıları için)
EXPO_PUBLIC_WEB_URL=
# Abonelik koşulları / gizlilik politikası sayfalarının kökü
# Set both only after lawyer-reviewed documents are published and checked.
# Root must be https://ginafamily.com; version format YYYY-MM-DD.N (e.g. revision 1).
EXPO_PUBLIC_LEGAL_BASE_URL=
EXPO_PUBLIC_LEGAL_VERSION=
